<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/scala_widget_bg"
    android:padding="12dp">

  <LinearLayout
      android:id="@+id/scala_widget_header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingBottom="8dp">
    <TextView
        android:id="@+id/scala_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scala"
        android:textColor="#89b4fa"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/scala_widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#a6adc8"
        android:textSize="12sp" />
  </LinearLayout>

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">
    <ListView
        android:id="@+id/scala_widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp" />
    <TextView
        android:id="@+id/scala_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="No upcoming events"
        android:textColor="#6c7086"
        android:textSize="13sp" />
  </FrameLayout>
</LinearLayout>
